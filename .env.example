DATABASE_URL=postgresql://ai_sns:ai_sns@postgres:5432/ai_sns

ADMIN_API_PORT=7100
ADMIN_JWT_SECRET=replace-with-a-long-random-local-secret
ADMIN_BOOTSTRAP_EMAIL=admin@opod.local
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-local-admin-password

# 워커 자동 루프는 admin 설정 화면(설정 > 워커)이 소유한다. 아래 두 값은 DB에
# 아직 저장된 적이 없을 때만 쓰는 초기 기본값이다 — 화면에서 한 번 저장하면
# 무시된다. DRAFT_SCHEDULER_ENABLED는 아직 env 전용이다.
WORKER_ENABLED=false
EVALUATION_WORKER_ENABLED=false
DRAFT_SCHEDULER_ENABLED=false

S3_BUCKET=dev-opod-public
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://dev-opod-public.s3.ap-northeast-2.amazonaws.com
